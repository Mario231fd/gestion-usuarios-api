extends layout

block content
    main.error-page
        div.error-orbit.error-orbit-one(aria-hidden="true")
        div.error-orbit.error-orbit-two(aria-hidden="true")
        section.error-card(aria-labelledby="errorTitle")
            span.error-illustration(aria-hidden="true") !
            span.error-code= error.status || 500
            h1#errorTitle Vaya, algo no ha salido bien
            p.error-message= message || "No hemos podido encontrar esa página."
            div.error-actions
                a.btn-login(href="/") Volver al inicio
                a.btn-error-secondary(href="/login") Iniciar sesión