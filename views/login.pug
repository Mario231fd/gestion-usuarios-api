
extends layout

block content
    div.login-container
        h1 Bienvenido
        p.subtitle Inicia sesión en tu cuenta

        p#error.error

        form#loginForm
            label(for="email") Correo electrónico
            input(
                type="email"
                id="email"
                name="email"
                placeholder="Introduce tu correo"
                required
            )

            label(for="password") Contraseña
            input(
                type="password"
                id="password"
                name="password"
                placeholder="Introduce tu contraseña"
                required
            )

            button(type="submit") Iniciar sesión

        p.footer ¿Todavía no tienes cuenta?
        a.btn-registro(href="/registro") Crear una cuenta

    script(src="/javascripts/login.js")
