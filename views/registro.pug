
extends layout

block content
    div.login-container
        h1 Crear cuenta
        p.subtitle Introduce los datos del usuario

        form#registroForm
            label(for="nombre") Nombre
            input(type="text" id="nombre" name="nombre" maxlength="100" required)

            label(for="apellidos") Apellidos
            input(type="text" id="apellidos" name="apellidos" maxlength="150" required)

            label(for="email") Email
            input(type="email" id="email" name="email" maxlength="254" required)

            label(for="password") Contraseña
            input(type="password" id="password" name="password" minlength="12" required)

            label(for="foto") Foto (URL)
            input(type="url" id="foto" name="foto" placeholder="Introduce la URL de la foto")

            label(for="grupoId") Grupo
            select(id="grupoId" name="grupoId" required)
                option(value="" disabled selected) Selecciona un grupo
                each grupo in grupos
                    option(value=grupo.id)= grupo.nombre

            label(for="rol") Rol
            select(id="rol" name="rol" required)
                option(value="USUARIO" selected) Usuario
                option(value="ADMIN") Administrador

            label(for="activo") Estado
            select(id="activo" name="activo" required)
                option(value="true" selected) Activo
                option(value="false") Inactivo

            p#error.error

            button(type="submit") Registrarme

        p.footer ¿Ya tienes cuenta?
        a.btn-registro(href="/login") Volver al login

    script(src="/javascripts/registro.js")
